@page "/"
@inject NavigationManager Nav

<div class="home-wrapper fade-in">

    <!-- HERO -->
    <section class="hero">
        <br />
        <span class="badge">🚀 Learn Tech the Fun Way</span>

        <h1 class="title">
            Tech Vocabulary Builder
        </h1>

        <p class="subtitle">
            Master <b>API</b>, <b>JWT</b>, <b>Docker</b> with
            interactive lessons and fun quizzes.
        </p>
    </section>

    <!-- ACTION CARDS -->
    <section class="card-section">

        <div class="card learn-card bounce" @onclick="GoToLearn">
            <div class="icon">📘</div>
            <h3>Learn Topics</h3>
            <p>Understand concepts with examples & code.</p>
            <button class="card-btn">Start Learning</button>
        </div>

        <div class="card game-card bounce" @onclick="GoToInstructions">
            <div class="icon">🎯</div>
            <h3>Guess the Term</h3>
            <p>Quick quizzes to test your understanding.</p>
            <button class="card-btn">Play Quiz</button>
        </div>

    </section>

    <!-- MOTIVATION -->
    <section class="motivation">
        <div class="tip">🧠 Learn by doing</div>
        <div class="tip">⚡ Short & effective</div>
        <div class="tip">🏆 Improve every day</div>
    </section>

</div>

@code {
    void GoToLearn()
    {
        Nav.NavigateTo("/topics");
    }

    void GoToInstructions()
    {
        Nav.NavigateTo("/game-instructions");
    }
}
