@page "/"
@inject NavigationManager Nav

<div class="home-wrapper">

    <!-- HERO -->
    <section class="hero">
        <div class="badge">🔥 Learn • Play • Master</div>

        <h1 class="title">
            Tech Vocabulary Builder
        </h1>

        <p class="subtitle">
            Learn technical concepts like <b>API</b>, <b>JWT</b>, <b>Docker</b>  
            in a fun way.
        </p>
    </section>

    <!-- ACTION CARDS -->
    <section class="card-section">

        <div class="card learn-card" @onclick="GoToLearn">
            <div class="icon">📘</div>
            <h3>Learn Topics</h3>
            <p>
                Clear explanations with real-world examples and code snippets.
            </p>
            <span class="card-cta">Start Learning →</span>
        </div>

        <div class="card game-card" @onclick="GoToInstructions">
            <div class="icon">🎯</div>
            <h3>Guess the Term</h3>
            <p>
                Test yourself with fun quizzes and boost your confidence.
            </p>
            <span class="card-cta">Play Now →</span>
        </div>

    </section>

    <!-- FEATURES -->
    <section class="features">
        <div class="feature">⚡ Quick & Simple</div>
        <div class="feature">🧠 Learn by Doing</div>
        <div class="feature">🏆 Score & Improve</div>
    </section>

</div>

@code {
    void GoToLearn()
    {
        Nav.NavigateTo("/topics");
    }

    void GoToInstructions()
    {
        Nav.NavigateTo("/game-instructions");
    }
}
