<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView 
            RouteData="@routeData"
            DefaultLayout="@typeof(TechVocabularyBlazorWasm.Layout.MainLayout)" />
    </Found>

    <NotFound>
        <LayoutView Layout="@typeof(TechVocabularyBlazorWasm.Layout.MainLayout)">
            <p>Sorry, nothing here.</p>
        </LayoutView>
    </NotFound>
</Router>
