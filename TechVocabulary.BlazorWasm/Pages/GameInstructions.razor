@page "/game-instructions"

@inject NavigationManager Nav
@inject HttpClient Http
@inject GameStateService GameState

@using TechVocabulary.Contracts.DTOs

<div class="instructions-wrapper">
    <h1 class="title">🎯 Guess the Term</h1>

    <p class="subtitle">
        You will be given a question and 4 options.
        Each correct answer gives you 1 point. All the best!
    </p>

    <ul class="instructions-list">
        <li>📝 Read the question carefully.</li>
        <li>🎯 Only <b>one attempt</b> per question.</li>
        <li>⏱️ Answer as quickly as possible to maximize your score.</li>
        <li>💡 Have fun learning technical terms like <b>API</b>, <b>JWT</b>, <b>Docker</b>!</li>
    </ul>

    <div class="start-btn-wrapper">
        <button class="btn-start" @onclick="StartGameAsync">
            🚀 Start Quiz
        </button>
    </div>
</div>

@if (showCompletedPopup)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <h2>🚫 Quiz Already Completed</h2>
            <p>
                You have already attempted this quiz.<br />
                You cannot retake it again.
            </p>

            <div class="modal-actions">
                <button class="btn-primary" @onclick="GoToResult">
                    📊 View Result
                </button>
                <button class="btn-secondary" @onclick="ClosePopup">
                    ❌ Close
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool showCompletedPopup = false;

    private async Task StartGameAsync()
    {
        try
        {
            var question =
                await Http.GetFromJsonAsync<GameQuestionResponse>(
                    "api/game/question");

            if (question == null)
                return;

            // 🔴 USER ALREADY COMPLETED QUIZ
            if (question.IsCompleted)
            {
                showCompletedPopup = true;
                return;
            }

            // ✅ START GAME
            GameState.Reset();
            GameState.CurrentQuestion = question;
            Nav.NavigateTo("/game");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching game question: {ex.Message}");
        }
    }

    void ClosePopup()
    {
        showCompletedPopup = false;
    }

    void GoToResult()
    {
        Nav.NavigateTo("/game-result");
    }
}
