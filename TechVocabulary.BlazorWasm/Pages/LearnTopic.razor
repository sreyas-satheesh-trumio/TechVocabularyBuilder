@page "/learn"
@using TechVocabulary.BlazorWasm.Services
@using TechVocabulary.Contracts.DTOs

@inject LearningApiService LearningService

<h3 class="mb-3">📘 Learn Tech Vocabulary</h3>

<!-- SEARCH -->
<div class="mb-3">
    <input class="form-control"
           placeholder="Search topic (e.g., API)"
           @bind="topicName" />
</div>

<button class="btn btn-primary mb-4" @onclick="SearchTopic">
    Learn
</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<hr />

<!-- TOPIC LIST -->
<h5 class="mb-3">Available Topics</h5>

@if (topics == null)
{
    <p>Loading topics...</p>
}
else
{
    <div class="topic-grid">
        @foreach (var t in topics)
        {
            <div class="topic-card"
                 @onclick="() => LoadTopic(t.TopicName)">
                <span class="topic-text">@t.TopicName</span>
                <span class="ripple"></span>
            </div>
        }
    </div>
}


<!-- TOPIC DETAILS -->
@if (topic != null)
{
    <div class="card shadow">
        <div class="card-body">
            <h4 class="card-title">@topic.TopicName</h4>

            <p><strong>Definition:</strong><br />@topic.Definition</p>

            <p><strong>Real World Usage:</strong><br />@topic.RealWorldUsage</p>

            <p><strong>Code Snippet:</strong></p>

            <pre class="bg-light p-3 rounded">
@topic.CodeSnippet
            </pre>
        </div>
    </div>
}

@code {
    private string topicName = string.Empty;
    private LearningTopicDto? topic;
    private List<LearningTopicListDto>? topics;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        topics = await LearningService.GetAllTopicsAsync();
    }

    private async Task SearchTopic()
    {
        errorMessage = string.Empty;
        topic = null;

        if (string.IsNullOrWhiteSpace(topicName))
        {
            errorMessage = "Please enter a topic name.";
            return;
        }

        await LoadTopic(topicName);
    }

    private async Task LoadTopic(string name)
    {
        try
        {
            topic = await LearningService.GetTopicByNameAsync(name);

            if (topic == null)
                errorMessage = "Topic not found.";
        }
        catch
        {
            errorMessage = "Error fetching topic. Please try again.";
        }
    }
}

