@page "/"
@using TechVocabulary.Contracts.DTOs
@inject NavigationManager Nav
@inject HttpClient Http

<div class="home-wrapper">

    <!-- HERO -->
    <section class="hero">
        <h1 class="title">Tech Vocabulary Builder</h1>

        <p class="subtitle">
            Master technical concepts like <b>API</b>, <b>JWT</b>, <b>Docker</b>  
            through interactive lessons and fun quizzes.
        </p>
    </section>

    <!-- ACTION CARDS -->
    <section class="card-section">

        <div class="card learn-card" @onclick="GoToLearn">
            <div class="icon">📘</div>
            <h3>Learn Topics</h3>
            <p>Simple explanations with real-world examples.</p>
        </div>

        <div class="card game-card" @onclick="StartGameAsync">
            <div class="icon">🎯</div>
            <h3>Guess the Term</h3>
            <p>Test your knowledge with quick interactive quizzes.</p>
        </div>

    </section>

</div>

@code {
    void GoToLearn()
    {
        Nav.NavigateTo("/topics");
    }

    async Task StartGameAsync()
    {
        try
        {
            // Call backend to get the first question
            var question = await Http.GetFromJsonAsync<GameQuestionResponse>("api/game/question");

            if (question != null)
            {
                // Navigate to /game page
                // Later, pass the question via a state service or query string
                Nav.NavigateTo("/game");
            }
            else
            {
                Console.WriteLine("Failed to fetch first question.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching game question: {ex.Message}");
        }
    }
}
